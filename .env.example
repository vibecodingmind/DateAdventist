# Environment Configuration for AdventHearts Backend API

# Android client
API_BASE_URL=http://10.0.2.2:5000/api/v1/

# App & Environment
NODE_ENV=production
PORT=5000
APP_URL=https://adventhearts.com
API_URL=https://api.adventhearts.com/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://advent_user:SecurePassword123!@localhost:5432/adventhearts_db?schema=public

# Security & Authentication
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_32chars!
JWT_REFRESH_SECRET=super_secret_refresh_signing_key_change_in_production!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ARGON_MEMORY_COST=65536
ARGON_TIME_COST=3

# Object Storage (AWS S3 / Cloudflare R2)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_BUCKET=adventhearts-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Payment Gateways
STRIPE_PUBLISHABLE_KEY=pk_live_adventhearts_sample_key
