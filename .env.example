# Environment Configuration for AdventHearts

# Android client (emulator). On a physical device use http://<LAN-IP>:5000/api/v1/
API_BASE_URL=http://10.0.2.2:5000/api/v1/

# App & Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_URL=http://localhost:5000
API_URL=http://localhost:5000/api/v1

# Database — local SQLite. For production set a Postgres URL.
DATABASE_URL=file:./dev.db

# Security & Authentication (replace before deploying)
JWT_SECRET=change_me_to_a_long_random_jwt_secret
JWT_REFRESH_SECRET=change_me_to_a_long_random_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ARGON_MEMORY_COST=65536
ARGON_TIME_COST=3

# Object Storage (optional)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=adventhearts-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=replace_me
STORAGE_SECRET_KEY=replace_me

# Payment Gateways (optional — checkout currently confirms locally)
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me

# Email Provider (optional)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=replace_me
EMAIL_FROM=no-reply@example.com

# Cache & Realtime (optional)
REDIS_URL=redis://localhost:6379

# Firebase (optional)
FIREBASE_APP_ID=replace_me
FIREBASE_PROJECT_ID=replace_me
FIREBASE_TOKEN=replace_me
