# Environment Configuration for AdventHearts

# Android client (emulator). On a physical device use http://<LAN-IP>:5000/api/v1/
# Production Play Store build: https://<your-api-host>/api/v1/
API_BASE_URL=http://10.0.2.2:5000/api/v1/
# Optional. Defaults to the origin of API_BASE_URL (used for Terms / Privacy).
LEGAL_BASE_URL=http://10.0.2.2:5000

# App & Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_URL=http://localhost:5000
API_URL=http://localhost:5000/api/v1

# Database — local SQLite. For production set a persistent path (or Postgres later).
DATABASE_URL=file:./dev.db

# Security & Authentication — generate live secrets with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_jwt_secret
JWT_REFRESH_SECRET=change_me_to_a_long_random_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ARGON_MEMORY_COST=65536
ARGON_TIME_COST=3

# Production refuses to start if JWT secrets are missing, shorter than 32 chars, or contain "change_me".
# CORS_ORIGIN=https://app.adventhearts.com
# ALLOW_DEMO_SEED=false
# REQUIRE_EMAIL_VERIFICATION=true
# ALLOW_HTTP=false

# Object Storage (optional — photos currently use local UPLOAD_DIR)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=adventhearts-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=replace_me
STORAGE_SECRET_KEY=replace_me

# Payment Gateways — required for live Stripe checkout + webhooks
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me

# Public origin used for photo URLs, email links, Stripe return URLs, and legal pages
PUBLIC_BASE_URL=http://localhost:5000
UPLOAD_DIR=uploads

# Email Provider — Resend. If unset, verification/reset tokens are logged to the console.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=replace_me
EMAIL_FROM=AdventHearts <no-reply@adventhearts.com>

# Cache & Realtime (optional)
REDIS_URL=redis://localhost:6379

# Firebase (optional)
FIREBASE_APP_ID=replace_me
FIREBASE_PROJECT_ID=replace_me
FIREBASE_TOKEN=replace_me
