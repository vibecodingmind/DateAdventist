{
  "name": "adventhearts-backend",
  "version": "1.0.0",
  "description": "Production TypeScript REST API & Realtime Server for AdventHearts",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed": "ts-node --transpile-only src/seed.ts",
    "seed:admin": "ts-node --transpile-only src/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "db:setup": "prisma generate && prisma db push && npm run seed",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "type-check": "tsc --noEmit"
  },
  "prisma": {
    "seed": "ts-node --transpile-only src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "argon2": "^0.31.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.4",
    "stripe": "^14.17.0",
    "zod": "^3.22.4",
    "prisma": "^5.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.19",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
